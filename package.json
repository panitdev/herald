{
  "name": "herald",
  "private": true,
  "scripts": {
    "dev:ui": "bun --cwd packages/ui dev",
    "dev:api": "cargo run -p herald-api",
    "dev:receiver": "bun --cwd packages/workers-receiver dev",
    "deploy:receiver": "bun --cwd packages/workers-receiver deploy",
    "deploy:ui": "bun run --cwd packages/ui deploy",
    "build:api": "cargo build -p herald-api",
    "build:ui": "bun --cwd packages/ui build",
    "test:api": "cargo test -p herald-api",
    "test:receiver": "bun --cwd packages/workers-receiver test",
    "typecheck:receiver": "bun --cwd packages/workers-receiver typecheck",
    "dev": "docker compose -f infra/compose.yml up --build"
  },
  "workspaces": [
    "packages/ui"
  ],
  "overrides": {
    "@radix-ui/react-dismissable-layer": "1.1.15"
  }
}
